import tkinter as tk
from tkinter import ttk, messagebox
import random
import string
import json
import os

class PasswordGeneratorApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Random Password Generator")
        self.root.geometry("500x550")
        self.history_file = "history.json"
        
        # Переменные
        self.length_var = tk.IntVar(value=12)
        self.use_digits = tk.BooleanVar(value=True)
        self.use_letters = tk.BooleanVar(value=True)
        self.use_symbols = tk.BooleanVar(value=True)
        self.history = self.load_history()

        self.setup_ui()

    def setup_ui(self):
        # Настройка сетки
        frame = ttk.Frame(self.root, padding="10")
        frame.pack(fill=tk.BOTH, expand=True)

        # 1. Ползунок длины
        ttk.Label(frame, text="Длина пароля:").pack(pady=5)
        self.length_label = ttk.Label(frame, text="12")
        self.length_label.pack()
        
        slider = ttk.Scale(frame, from_=4, to=32, variable=self.length_var, 
                           orient='horizontal', command=self.update_label)
        slider.pack(fill=tk.X, pady=5)

        # 2. Чекбоксы
        ttk.Checkbutton(frame, text="Цифры (0-9)", variable=self.use_digits).pack(anchor=tk.W)
        ttk.Checkbutton(frame, text="Буквы (a-z, A-Z)", variable=self.use_letters).pack(anchor=tk.W)
        ttk.Checkbutton(frame, text="Спецсимволы (!@#$%^&*)", variable=self.use_symbols).pack(anchor=tk.W)

        # 3. Кнопка генерации
        self.generate_btn = ttk.Button(frame, text="Сгенерировать пароль", command=self.generate)
        self.generate_btn.pack(pady=15)

        self.result_entry = ttk.Entry(frame, font=("Helvetica", 12), justify='center')
        self.result_entry.pack(fill=tk.X, pady=5)

        # 4. Таблица истории
        ttk.Label(frame, text="История:").pack(pady=(10, 0))
        self.tree = ttk.Treeview(frame, columns=("Password"), show='headings', height=8)
        self.tree.heading("Password", text="Сгенерированные пароли")
        self.tree.pack(fill=tk.BOTH, expand=True)
        
        self.update_history_table()

    def update_label(self, event):
        self.length_label.config(text=str(self.length_var.get()))

    def generate(self):
        length = self.length_var.get()
        
        # Валидация
        if not (4 <= length <= 32):
            messagebox.showerror("Ошибка", "Длина должна быть от 4 до 32")
            return

        chars = ""
        if self.use_digits.get(): chars += string.digits
        if self.use_letters.get(): chars += string.letters
        if self.use_symbols.get(): chars += string.punctuation

        if not chars:
            messagebox.showwarning("Внимание", "Выберите хотя бы один тип символов!")
            return

        password = "".join(random.choice(chars) for _ in range(length))
        self.result_entry.delete(0, tk.END)
        self.result_entry.insert(0, password)
        
        self.save_to_history(password)

    def save_to_history(self, pwd):
        self.history.insert(0, pwd)
        self.history = self.history[:20]  # Храним последние 20
        with open(self.history_file, "w") as f:
            json.dump(self.history, f)
        self.update_history_table()

    def load_history(self):
        if os.path.exists(self.history_file):
            with open(self.history_file, "r") as f:
                return json.load(f)
        return []

    def update_history_table(self):
        for item in self.tree.get_children():
            self.tree.delete(item)
        for pwd in self.history:
            self.tree.insert("", tk.END, values=(pwd,))

if __name__ == "__main__":
    root = tk.Tk()
    app = PasswordGeneratorApp(root)
    root.mainloop()

